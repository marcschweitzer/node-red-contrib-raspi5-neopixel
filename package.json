{
  "name": "node-red-contrib-raspi5-neopixel",
  "version": "1.0.0",
  "description": "Raspberry Pi 5 WS2812 / NeoPixel pure JavaScript Node-RED node with SPI0/SPI1, selectable color order (RGB/GRB/...), brightness, per-pixel control and effects",
  "keywords": [
    "node-red",
    "node-red-contrib",
    "raspberry-pi",
    "raspberry-pi-5",
    "neopixel",
    "ws2812",
    "ws2812b",
    "led",
    "led-strip",
    "addressable",
    "spi",
    "spi0",
    "spi1"
  ],
  "license": "MIT",
  "main": "nodes/neopixel.js",
  "dependencies": {
    "spi-device": "^3.1.2"
  },
  "node-red": {
    "nodes": {
      "raspi5-neopixel": "nodes/neopixel.js"
    }
  },
  "author": "Marc S. (scwm)",
  "homepage": "https://github.com/marcschweitzer/node-red-contrib-raspi5-neopixel#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marcschweitzer/node-red-contrib-raspi5-neopixel.git"
  },
  "bugs": {
    "url": "https://github.com/marcschweitzer/node-red-contrib-raspi5-neopixel/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "nodes/",
    "lib/",
    "examples/",
    "README.md",
    "LICENSE"
  ]
}
